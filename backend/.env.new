# Environment Variables for Socialobby Backend

# Database Configuration (Using MongoDB Atlas Free Tier)
MONGODB_URI=mongodb+srv://test:test@cluster0.mongodb.net/socialobby?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=development-secret-key-2025-socialobby

# Server Configuration
PORT=5000
NODE_ENV=development

# Logging Level
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100