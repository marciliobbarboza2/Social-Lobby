# Example environment variables for the seed script
# Copy this to .env and fill secrets before running scripts in development.

# MongoDB connection string (optional)
# MONGODB_URI=mongodb://localhost:27017/socialobby

# Admin and account passwords (optional). If not set, the script will generate random
# passwords for newly created users and will not overwrite existing users' passwords.
SEED_PW_ADMIN=your_admin_password_here
SEED_PW_MARCILIO=your_marcilio_password_here
SEED_PW_USERA=optional_usera_password
SEED_PW_USERB=optional_userb_password
SEED_PW_USERC=optional_userc_password
SEED_PW_USERD=optional_userd_password
