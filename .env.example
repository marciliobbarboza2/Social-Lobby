# Server Configuration# Example environment variables for the seed script

PORT=5000# Copy this to .env and fill secrets before running scripts in development.

NODE_ENV=development

# MongoDB connection string (optional)

# MongoDB Configuration# MONGODB_URI=mongodb://localhost:27017/socialobby

MONGODB_URI=mongodb://localhost:27017/socialobby

# Admin and account passwords (optional). If not set, the script will generate random

# JWT Configuration# passwords for newly created users and will not overwrite existing users' passwords.

JWT_SECRET=your_jwt_secret_hereSEED_PW_ADMIN=your_admin_password_here

JWT_EXPIRY=7dSEED_PW_MARCILIO=your_marcilio_password_here

SEED_PW_USERA=optional_usera_password

# Admin User ConfigurationSEED_PW_USERB=optional_userb_password

ADMIN_EMAIL=admin@example.comSEED_PW_USERC=optional_userc_password

ADMIN_USERNAME=adminSEED_PW_USERD=optional_userd_password

# Never commit actual passwords, set these in your local .env file
ADMIN_PASSWORD=your_secure_password_here

# Default User Configuration (for testing)
DEFAULT_USER_PASSWORD=your_default_password_here